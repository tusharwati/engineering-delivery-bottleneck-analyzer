# ==========================================================
# Apache DevLake Database Connection (Read-Only)
# Pinned Version: Apache DevLake v1.0.2
# ==========================================================
# Local SQLite Mock / Seed Database (Default for zero-dependency local runs):
DEVLAKE_DB_URL=sqlite:///./data/mock_devlake.db

# Live Apache DevLake MySQL 8.0:
# DEVLAKE_DB_URL=mysql+pymysql://merico_ro:merico_ro_pass@127.0.0.1:3306/lake?charset=utf8mb4

# Live Apache DevLake PostgreSQL 14+:
# DEVLAKE_DB_URL=postgresql+psycopg2://merico_ro:merico_ro_pass@127.0.0.1:5432/lake

# ==========================================================
# Bottleneck Analyzer Local Configuration & Alert Store (SQLite)
# ==========================================================
APP_DB_URL=sqlite:///./data/app_state.db

# ==========================================================
# Business-Hours Review SLA Engine
# ==========================================================
# IANA Timezone Identifier (Default: Asia/Kolkata)
TIMEZONE=Asia/Kolkata

# Working Days of Week (0=Monday, 1=Tuesday, 2=Wednesday, 3=Thursday, 4=Friday)
WORK_DAYS=0,1,2,3,4

# Daily Business Opening and Closing Times (24-hour format HH:MM)
WORK_START_TIME=09:30
WORK_END_TIME=18:30

# Review SLA Threshold in Business Hours
REVIEW_SLA_HOURS=8.0

# Recognized Holidays (JSON Array of ISO YYYY-MM-DD dates)
HOLIDAYS_JSON=["2026-01-01","2026-01-26","2026-08-15","2026-10-02","2026-12-25"]

# ==========================================================
# Review Event & Bot Qualification Settings
# ==========================================================
# Filter automated CI/CD and bot accounts from qualifying reviews
EXCLUDE_BOTS=true

# If true, count non-author general discussion comments as review events.
# If false (recommended), only count formal reviews or inline diff comments.
INCLUDE_NORMAL_COMMENTS_AS_REVIEW=false

# Minimum historical reviewed PRs required before reporting learned repo baselines
MIN_HISTORICAL_SAMPLE_SIZE=10

# Lookback window in days for historical repo baselines
BASELINE_LOOKBACK_DAYS=30

# ==========================================================
# Automated Alerts & Slack Integration
# ==========================================================
# Incoming Webhook URL (Redacted in logs)
SLACK_WEBHOOK_URL=

# Dry Run Mode: logs full JSON payload without transmitting outbound network calls
ALERT_DRY_RUN=true

# Cooldown duration in hours before re-alerting for the same PR breach
ALERT_COOLDOWN_HOURS=24

# Alert poller background interval in minutes
POLL_INTERVAL_MINUTES=30

# ==========================================================
# FastAPI Server & Security Settings
# ==========================================================
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
DEMO_MODE=false

